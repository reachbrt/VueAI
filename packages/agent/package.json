{
  "name": "@aivue/agent",
  "version": "1.0.1",
  "description": "Agent runtime for Vue — streaming messages, tool calls, approvals, shared state, and generative UI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/agent.css",
    "./dist/agent.css": "./dist/agent.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "ai",
    "agent",
    "ag-ui",
    "generative-ui",
    "copilot",
    "aivue"
  ],
  "author": "reachbrt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reachbrt/VueAI.git",
    "directory": "packages/agent"
  },
  "homepage": "https://aivue.netlify.app",
  "bugs": {
    "url": "https://github.com/reachbrt/VueAI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^1.6.0",
    "vue": "^3.5.0"
  }
}
